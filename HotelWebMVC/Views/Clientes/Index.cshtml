@model IEnumerable<HotelServiciosAPI.Models.Cliente>

@{
    ViewData["Title"] = "Listado de Clientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-people-fill"></i> Gestión de Clientes</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus-fill"></i> Registrar Nuevo Cliente</a>
    </div>

    <!-- Formulario de Búsqueda -->
    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="identificacion" class="form-control" placeholder="Buscar cliente por identificación..." />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Buscar
            </button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </form>

    <!-- Mensaje si no se encuentra el cliente -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
            @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover table-striped align-middle m-0">
                <thead class="table-dark">
                    <tr>
                        <th>Identificación</th>
                        <th>Tipo</th>
                        <th>Nombre Completo</th>
                        <th>Fecha Nacimiento</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.Identificacion</strong></td>
                                <td>@item.TipoIdentificacion</td>
                                <td>@item.Nombre @item.PrimerApellido @item.SegundoApellido</td>
                                <td>@item.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Identificacion" class="btn btn-sm btn-outline-warning">Editar</a>
                                        <a asp-action="Details" asp-route-id="@item.Identificacion" class="btn btn-sm btn-outline-info">Ver</a>
                                        <a asp-action="Delete" asp-route-id="@item.Identificacion" class="btn btn-sm btn-outline-danger">Borrar</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No hay clientes registrados en el sistema.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>