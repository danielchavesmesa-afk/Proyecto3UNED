@model HotelServiciosAPI.Models.Cliente

@{
    ViewData["Title"] = "Detalles del Cliente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0"><i class="bi bi-eye"></i> Ficha del Cliente</h4>
                </div>
                <div class="card-body">
                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted">Identificación:</dt>
                        <dd class="col-sm-8"><strong>@Model.Identificacion</strong> (@Model.TipoIdentificacion)</dd>

                        <dt class="col-sm-4 text-muted">Nombre Completo:</dt>
                        <dd class="col-sm-8">@Model.Nombre @Model.PrimerApellido @Model.SegundoApellido</dd>

                        <dt class="col-sm-4 text-muted">Fecha de Nacimiento:</dt>
                        <dd class="col-sm-8">@Model.FechaNacimiento.ToString("dd/MM/yyyy")</dd>
                    </dl>
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Regresar al Listado</a>
                        <a asp-action="Edit" asp-route-id="@Model.Identificacion" class="btn btn-warning">Editar Información</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>