@model HotelServiciosAPI.Models.Empleado

@{
    ViewData["Title"] = "Eliminar Empleado";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-0 mt-4">
            <div class="card-body text-center p-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill display-3"></i>
                </div>
                <h3 class="card-title text-danger mb-2">¿Confirmar baja del Empleado?</h3>
                <p class="text-muted">Esta acción removerá de forma permanente al funcionario del sistema del hotel.</p>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-x-circle-fill"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <div class="bg-light p-3 rounded text-start my-4 border">
                    <p class="mb-1"><strong>Empleado:</strong> @Model.Nombre @Model.PrimerApellido</p>
                    <p class="mb-1"><strong>Identificación:</strong> @Model.Identificacion</p>
                    <p class="mb-0"><strong>Puesto:</strong> @Model.Puesto</p>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Identificacion">
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold">Eliminar Definitivamente</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>