@model HotelServiciosAPI.Models.Empleado

@{
    ViewData["Title"] = "Editar Empleado";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Modificar Datos del Empleado</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="Identificacion" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-muted">Identificación (No modificable)</label>
                            <input class="form-control bg-light" value="@Model.Identificacion" readonly />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Puesto" class="form-label fw-bold">Puesto u Oficio</label>
                            <select asp-for="Puesto" class="form-select">
                                <option value="Recepcionista">Recepcionista</option>
                                <option value="Administrador">Administrador</option>
                                <option value="Mantenimiento">Mantenimiento</option>
                                <option value="Ama de Llaves">Ama de Llaves</option>
                                <option value="Gerente">Gerente</option>
                            </select>
                            <span asp-validation-for="Puesto" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre</label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="PrimerApellido" class="form-label fw-bold">Primer Apellido</label>
                            <input asp-for="PrimerApellido" class="form-control" />
                            <span asp-validation-for="PrimerApellido" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="SegundoApellido" class="form-label fw-bold">Segundo Apellido</label>
                            <input asp-for="SegundoApellido" class="form-control" />
                            <span asp-validation-for="SegundoApellido" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="text-secondary border-bottom pb-2 mt-3 mb-3"><i class="bi bi-geo-alt-fill"></i> Ubicación Actualizada</h5>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Provincia" class="form-label fw-bold">Provincia</label>
                            <input asp-for="Provincia" class="form-control" />
                            <span asp-validation-for="Provincia" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Canton" class="form-label fw-bold">Cantón</label>
                            <input asp-for="Canton" class="form-control" />
                            <span asp-validation-for="Canton" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Distrito" class="form-label fw-bold">Distrito</label>
                            <input asp-for="Distrito" class="form-control" />
                            <span asp-validation-for="Distrito" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-warning px-4 text-dark fw-bold">Actualizar Datos</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
