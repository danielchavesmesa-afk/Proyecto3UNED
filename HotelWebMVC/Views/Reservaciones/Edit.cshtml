@model HotelServiciosAPI.Models.Reservacion

@{
    ViewData["Title"] = "Gestionar Estado de Reservación";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0"><i class="bi bi-arrow-repeat"></i> Actualizar Estado / Cancelaciones</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <input type="hidden" asp-for="CodigoReservacion" />
                    <input type="hidden" asp-for="ClienteId" />
                    <input type="hidden" asp-for="HabitacionNumero" />
                    <input type="hidden" asp-for="FechaInicio" />
                    <input type="hidden" asp-for="FechaSalida" />

                    <div class="alert alert-light border mb-4">
                        <h6><strong>Código de Reserva:</strong> @Model.CodigoReservacion</h6>
                        <div><strong>Huésped:</strong> @Model.ClienteId</div>
                        <div><strong>Habitación:</strong> @Model.HabitacionNumero</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Estado" class="form-label fw-bold">Estado de la Reservación</label>
                        <select asp-for="Estado" class="form-select">
                            <option value="Activa">Activa / Vigente</option>
                            <option value="Cancelada">Cancelada</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SolicitudesEspeciales" class="form-label fw-bold">Notas Adicionales</label>
                        <textarea asp-for="SolicitudesEspeciales" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="SolicitudesEspeciales" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Regresar</a>
                        <button type="submit" class="btn btn-warning text-dark fw-bold px-4">Actualizar Registro</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>