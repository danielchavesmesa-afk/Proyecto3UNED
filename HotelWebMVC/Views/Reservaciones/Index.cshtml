@model IEnumerable<HotelServiciosAPI.Models.Reservacion>

@{
    ViewData["Title"] = "Listado de Reservaciones";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-primary"><i class="bi bi-calendar-check-fill"></i> Libro de Reservaciones</h1>
    <a asp-action="Create" class="btn btn-success shadow-sm">
        <i class="bi bi-calendar-plus"></i> Registrar Nueva Reservación
    </a>
</div>

<!-- Formulario de Búsqueda -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="codigo" class="form-control" placeholder="Buscar reservación por código (ej. RES-1234)..." />
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i> Buscar
        </button>
        <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
    </div>
</form>

<!-- Mensaje de Alerta si no se encuentra la reservación -->
@if (ViewBag.Error != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Código</th>
                    <th>Cliente (ID)</th>
                    <th>Habitación</th>
                    <th>Estadía (Desde / Hasta)</th>
                    <th>Monto Total</th>
                    <th>Estado</th>
                    <th class="text-center" style="width: 180px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="bi bi-info-circle fs-4 d-block mb-2"></i> No hay reservaciones registradas en el sistema.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold font-monospace text-primary">@item.CodigoReservacion</td>
                            <td>@item.ClienteId</td>
                            <td><span class="badge bg-secondary">Hab. @item.HabitacionNumero</span></td>
                            <td>
                                <small>
                                    <strong>Inicia:</strong> @item.FechaInicio.ToString("dd/MM/yyyy") <br />
                                    <strong>Termina:</strong> @item.FechaSalida.ToString("dd/MM/yyyy")
                                </small>
                            </td>

                            <td>@item.MontoTotal.ToString("C2")</td>

                            <td>
                                @if (item.Estado == "Activa")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-lg"></i> Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Cancelada</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.CodigoReservacion" class="btn btn-sm btn-outline-warning" title="Cambiar Estado">Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.CodigoReservacion" class="btn btn-sm btn-outline-info" title="Ver Detalles">Ver</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>