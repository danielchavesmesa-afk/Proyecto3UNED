@model HotelServiciosAPI.Models.Habitacion

@{
    ViewData["Title"] = "Eliminar Habitación";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm mt-4">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0"><i class="bi bi-exclamation-octagon"></i> ¿Confirmar Remoción de Habitación?</h4>
            </div>
            <div class="card-body p-4 text-center">

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger text-start mb-3" role="alert">
                        <i class="bi bi-x-circle-fill"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <p class="text-muted">Se eliminará la habitación del inventario físico del hotel.</p>

                <div class="alert alert-light border text-start my-3">
                    <strong>Número:</strong> @Model.Numero <br />
                    <strong>Tipo:</strong> @Model.Tipo <br />
                    <strong>Tarifa Básica:</strong> @Model.PrecioPorNoche.ToString("C")
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Numero" />
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4">Eliminar Registro</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>