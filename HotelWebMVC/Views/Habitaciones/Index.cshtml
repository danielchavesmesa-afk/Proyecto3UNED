@model IEnumerable<HotelServiciosAPI.Models.Habitacion>

@{
    ViewData["Title"] = "Listado de Habitaciones";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-primary"><i class="bi bi-door-open-fill"></i> Mantenimiento de Habitaciones</h1>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle-fill"></i> Agregar Habitación
    </a>
</div>

<!-- 🔍 Formulario de Búsqueda -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="numero" class="form-control" placeholder="Buscar habitación por número..." />
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i> Buscar
        </button>
        <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
    </div>
</form>

<!-- Mensaje de Alerta si no se encuentra la habitación -->
@if (ViewBag.Error != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Número</th>
                    <th>Tipo</th>
                    <th>Precio por Noche</th>
                    <th>Estado</th>
                    <th class="text-center" style="width: 220px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="bi bi-info-circle fs-4 d-block mb-2"></i> No hay habitaciones registradas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Numero</td>
                            <td>@item.Tipo</td>
                            <td>@item.PrecioPorNoche.ToString("C")</td>
                            <td>
                                @if (item.Estado == "Disponible")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Disponible</span>
                                }
                                else if (item.Estado == "Ocupada")
                                {
                                    <span class="badge bg-danger"><i class="bi bi-person-fill"></i> Ocupada</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-gear-fill"></i> Mantenimiento</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Numero" class="btn btn-sm btn-outline-warning">Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.Numero" class="btn btn-sm btn-outline-info">Ver</a>
                                    <a asp-action="Delete" asp-route-id="@item.Numero" class="btn btn-sm btn-outline-danger">Borrar</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
