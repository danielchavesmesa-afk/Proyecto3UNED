  "components": {
    "schemas": {
      "Cliente": {
        "required": [
          "tipoIdentificacion",
          "identificacion",
          "nombre",
          "primerApellido",
          "fechaNacimiento"
        ],
        "type": "object",
        "properties": {
          "tipoIdentificacion": {
            "type": "string"
          },
          "identificacion": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "nombre": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "primerApellido": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "segundoApellido": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "fechaNacimiento": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Empleado": {
        "required": [
          "identificacion",
          "nombre",
          "primerApellido",
          "puesto",
          "provincia",
          "canton",
          "distrito"
        ],
        "type": "object",
        "properties": {
          "identificacion": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "nombre": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "primerApellido": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "segundoApellido": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "puesto": {
            "type": "string"
          },
          "provincia": {
            "type": "string"
          },
          "canton": {
            "type": "string"
          },
          "distrito": {
            "type": "string"
          }
        }
      },
      "Habitacion": {
        "required": [
          "numero",
          "tipo",
          "precioPorNoche",
          "estado"
        ],
        "type": "object",
        "properties": {
          "numero": {
            "pattern": "^[0-9]+$",
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "precioPorNoche": {
            "maximum": 1000000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "estado": {
            "type": "string"
          }
        }
      },
      "Reservacion": {
        "required": [
          "codigoReservacion",
          "clienteId",
          "habitacionNumero",
          "fechaInicio",
          "fechaSalida",
          "estado"
        ],
        "type": "object",
        "properties": {
          "codigoReservacion": {
            "type": "string"
          },
          "clienteId": {
            "type": "string"
          },
          "habitacionNumero": {
            "type": "string"
          },
          "fechaInicio": {
            "type": "string",
            "format": "date-time"
          },
          "fechaSalida": {
            "type": "string",
            "format": "date-time"
          },
          "estado": {
            "type": "string"
          },
          "solicitudesEspeciales": {
            "maxLength": 250,
            "minLength": 0,
            "type": "string"
          },
          "tarifaCalculada": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "porcentajeDescuento": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "montoTotal": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "fechaRealizacion": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "temperatureF": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
